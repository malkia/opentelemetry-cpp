ARG BASE_IMAGE=alpine:3.24.3@sha256:1b7232cda4ca3dc20b5d1247bdc9bfb631f2661d15d323bdd6fccc035ed1a9e7

FROM ${BASE_IMAGE} AS final

RUN apk update

RUN apk add --update alpine-sdk \
    && apk add cmake g++ \
    git autoconf libtool linux-headers \
    openssl openssl-dev \
    libevent-dev

WORKDIR /work
